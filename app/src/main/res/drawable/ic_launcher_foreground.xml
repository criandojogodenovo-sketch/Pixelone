    <path
        android:fillColor="#F57C00"
        android:pathData="M62,48h12v12h-12z" />

    <!-- Linha inferior -->
    <path
        android:fillColor="#4A4A4A"
        android:pathData="M34,62h12v12h-12z" />
    <path
        android:fillColor="#F57C00"
        android:pathData="M48,62h12v12h-12z" />
